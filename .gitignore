# INGOL generated and local state must never become authoritative source.
.ingol/generated/
generated/

# Meeting data: client recordings, frames, transcripts and reports never
# enter the repository. meetingtool/repository_guard.py holds the same list
# and a test fails if one is tracked anyway. Patterns cover every letter
# case: on Linux git matches case exactly.
# Video.
*.[aA][vV][iI]
*.[mM]4[vV]
*.[mM][kK][vV]
*.[mM][oO][vV]
*.[mM][pP]4
*.[wW][eE][bB][mM]
*.[wW][mM][vV]
# Audio.
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[mM]4[aA]
*.[mM][pP]3
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[wW][aA][vV]
*.[wW][mM][aA]
# Images and extracted frames.
*.[bB][mM][pP]
*.[gG][iI][fF]
*.[hH][eE][iI][cC]
*.[jJ][pP][eE][gG]
*.[jJ][pP][gG]
*.[pP][nN][gG]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[wW][eE][bB][pP]
# Subtitles.
*.[sS][rR][tT]
*.[vV][tT][tT]
# Documents and reports.
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[pP][dD][fF]
*.[pP][pP][tT][xX]
*.[xX][lL][sS][xX]
# Root data folders, anchored so a code folder with the same name is never ignored.
/frames/
/meetings/
/projects/

# Credentials.
.env
*.env

# Python and local build/test state.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/
.cache/
.tmp/

# IDE and OS state.
.idea/
.vscode/
.DS_Store
Thumbs.db
