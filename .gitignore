# INGOL generated and local state must never become authoritative source.
.ingol/generated/
generated/

# Meeting data: client recordings, transcripts and reports never enter the
# repository. A test also fails if one does (WI028, datos de clientes).
# Patterns cover every letter case: on Linux git matches case exactly.
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[aA]
*.[wW][aA][vV]
*.[dD][oO][cC][xX]
*.[vV][tT][tT]
# Anchored to the root so a code subpackage with the same name is never ignored.
/meetings/
/projects/
/frames/

# Credentials.
.env
*.env

# Python and local build/test state.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/
.cache/
.tmp/

# IDE and OS state.
.idea/
.vscode/
.DS_Store
Thumbs.db
